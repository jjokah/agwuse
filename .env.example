# Database (PostgreSQL)
# These defaults match docker-compose.yml, which maps the container to host
# port 5433 (NOT the default 5432) to avoid clashing with a local Postgres.
DIRECT_DATABASE_URL="postgresql://agwuse:agwuse_dev_2026@localhost:5433/agwuse"
DATABASE_URL="postgresql://agwuse:agwuse_dev_2026@localhost:5433/agwuse"

# Auth.js
# Generate with: openssl rand -base64 32  (legacy NEXTAUTH_SECRET is also accepted)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Email (Resend)
# Use "log" for core local development; use "resend" to send real email.
EMAIL_TRANSPORT="log"
EMAIL_FROM="AG Wuse <info@agwuse.org>"
RESEND_API_KEY=""

# Paystack
# The current server-side flow uses PAYSTACK_SECRET_KEY; the public key is
# retained for compatibility with any future client-side integration.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional tuning
DATABASE_POOL_MAX="5"
AUTH_REVALIDATE_SECONDS="60"
TRUSTED_PROXY_HOPS="1"

# Optional seed overrides (set a strong local password before first seed)
SEED_ADMIN_EMAIL="admin@agwuse.org"
SEED_ADMIN_PASSWORD=""
